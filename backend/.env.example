# 3D Color Concierge Backend Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# CORS設定（カンマ区切り）
# 開発環境のオリジンを追加してください
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 環境設定
# development, staging, production
ENVIRONMENT=development

# API設定
API_VERSION=v1

# フェーズ4.2で追加予定: Gemini APIキー
# Google Cloud Consoleで取得してください
# https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# AWS認証情報は.envファイルには含めないでください
# AWS CLI設定ファイル（~/.aws/credentials）を使用してください
# aws configure --profile 3d-color-concierge

# LMOps: 会話ログ保存先S3バケット名（terraform output conv_log_s3_bucket_name で確認）
# ローカル開発時は空欄のままでOK（S3への書き込みをスキップ）
# CONV_LOG_S3_BUCKET=3d-color-concierge-conv-logs-dev-xxxxxxxx
